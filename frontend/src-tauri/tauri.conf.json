{
  "$schema": "https://raw.githubusercontent.com/nicepkg/vscode-tauri/main/schemas/tauri.conf.schema.json",
  "productName": "Codex Cockpit Lite",
  "version": "0.1.0",
  "identifier": "com.codex-cockpit-lite",
  "build": {
    "beforeDevCommand": "python3 ../scripts/build_sidecar.py && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "python3 ../scripts/build_sidecar.py",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Codex Cockpit Lite",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "externalBin": ["binaries/codex-cockpit-backend"]
  },
  "plugins": {}
}
